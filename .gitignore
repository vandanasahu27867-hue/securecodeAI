# ========================
# AI Code Security — .gitignore
# ========================

# ----- Secrets -----
# NEVER commit API keys or environment secrets
.env

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ----- Virtual Environments -----
.venv/
venv/
env/

# ----- Generated Output -----
# Scanner results and AI-generated patches are generated artifacts.
# Uncomment the lines below if you do NOT want to commit them.
# results/
# patches/

# ----- OS / Editor -----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
